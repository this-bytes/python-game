# Backend Server Configuration
BACKEND_PORT=5000
BACKEND_HOST=0.0.0.0
BACKEND_DEBUG=True
ENABLE_BACKEND=False
CORS_ORIGINS=*

# Game Configuration
GAME_WINDOW_WIDTH=1280
GAME_WINDOW_HEIGHT=720
GAME_FPS=60

# API Security
API_SECRET_KEY=change-this-in-production-to-secure-random-key
API_TOKEN_EXPIRY=3600

# Logging
LOG_LEVEL=INFO
LOG_FILE=game.log

# Data Paths
DATA_DIR=data
SAVES_DIR=data/saves

# Development
DEBUG_MODE=true
HOT_RELOAD_ENABLED=true
