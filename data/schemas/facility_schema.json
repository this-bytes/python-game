{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "facility_schema.json",
  "title": "Facilities Configuration",
  "description": "Schema for facility configurations file",
  "type": "object",
  "required": ["facilities"],
  "properties": {
    "facilities": {
      "type": "array",
      "description": "Array of facility configurations",
      "items": {
        "type": "object",
        "required": ["id", "name", "facility_type", "level", "max_level", "upgrade_cost"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the facility",
            "pattern": "^[a-z_]+$"
          },
          "name": {
            "type": "string",
            "description": "Display name of the facility",
            "minLength": 2,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "description": "Description of the facility",
            "maxLength": 500
          },
          "facility_type": {
            "type": "string",
            "description": "Type of facility",
            "enum": ["office_space", "server_room", "training_center", "break_room", "security_operations_center"]
          },
          "level": {
            "type": "integer",
            "description": "Current level of the facility",
            "minimum": 1
          },
          "max_level": {
            "type": "integer",
            "description": "Maximum level the facility can reach",
            "minimum": 1,
            "maximum": 100
          },
          "upgrade_cost": {
            "type": "integer",
            "description": "Base cost to upgrade the facility",
            "minimum": 0
          },
          "bonuses": {
            "type": "object",
            "description": "Bonuses provided by this facility",
            "properties": {
              "max_specialists": {
                "type": "integer",
                "minimum": 0
              },
              "max_active_incidents": {
                "type": "integer",
                "minimum": 0
              },
              "incident_resolution_speed": {
                "type": "number",
                "minimum": 0
              },
              "xp_multiplier": {
                "type": "number",
                "minimum": 0
              },
              "fatigue_reduction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1.0
              }
            }
          }
        }
      }
    }
  }
}
