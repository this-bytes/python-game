  "resolution_trees": {
    "ddos_attack": {
      "name": "DDoS Attack Resolution",
      "description": "Resolve a distributed denial of service attack",
      "stages": [
        {
          "stage_id": "containment",
          "prompt": "DDoS attack detected. How do you respond?",
          "time_limit_seconds": 30,
          "decisions": [
            {
              "id": "block_ips",
              "text": "Block attacking IP ranges",
              "effects": {
                "time_multiplier": 0.8,
                "accuracy_check": true,
                "burnout_cost": 5,
                "success_chance": 0.85
              },
              "next_stage": "investigation"
            },
            {
              "id": "migrate_cdn",
              "text": "Migrate traffic to CDN",
              "effects": {
                "time_multiplier": 0.5,
                "money_cost": 2000,
                "burnout_cost": 2,
                "success_chance": 0.95
              },
              "next_stage": "investigation"
            },
            {
              "id": "analyze_first",
              "text": "Analyze attack pattern first",
              "effects": {
                "time_multiplier": 1.2,
                "accuracy_bonus": 20,
                "burnout_cost": 10,
                "success_chance": 0.75
              },
              "next_stage": "investigation"
            }
          ]
        },
        {
          "stage_id": "investigation",
          "prompt": "Attack contained. Now investigate the source.",
          "time_limit_seconds": 45,
          "decisions": [
            {
              "id": "trace_origin",
              "text": "Trace attack origin",
              "effects": {
                "time_multiplier": 1.0,
                "accuracy_check": true,
                "burnout_cost": 8,
                "success_chance": 0.8
              },
              "next_stage": "mitigation"
            },
            {
              "id": "check_logs",
              "text": "Analyze server logs",
              "effects": {
                "time_multiplier": 0.7,
                "accuracy_bonus": 15,
                "burnout_cost": 6,
                "success_chance": 0.9
              },
              "next_stage": "mitigation"
            }
          ]
        },
        {
          "stage_id": "mitigation",
          "prompt": "Source identified. Implement permanent mitigation.",
          "time_limit_seconds": 60,
          "decisions": [
            {
              "id": "rate_limiting",
              "text": "Implement rate limiting",
              "effects": {
                "time_multiplier": 0.6,
                "accuracy_check": true,
                "burnout_cost": 7,
                "success_chance": 0.88
              },
              "resolution_complete": true
            },
            {
              "id": "firewall_rules",
              "text": "Update firewall rules",
              "effects": {
                "time_multiplier": 0.8,
                "accuracy_bonus": 10,
                "burnout_cost": 5,
                "success_chance": 0.92
              },
              "resolution_complete": true
            }
          ]
        }
      ]
